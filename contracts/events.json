{
  "$comment": "robotd 公开事件登记表（R03 产出）。这是 contracts/openapi.yaml 之外的第二份机器可读契约，理由见文件末尾 notes：OpenAPI 3.0 无法表达 WS 事件的 payload 变体，用独立登记表替代『在散文里列事件名』。由 contracts/tools/generate.mjs 一并产出 generated/robotd-events.json。",
  "version": 1,
  "envelope": {
    "required": ["version", "type", "event_id", "seq", "timestamp", "payload"],
    "forbidden_payload_keys": ["ts_mono_ns", "mono_ns", "model_text", "self_check_text"],
    "forbidden_payload_keys_reason": "内部单调时钟与模型自检中间文本不得外泄给 Agent；它们只用于进程内对齐与调试。"
  },
  "filter_semantics": {
    "exact": "事件名完全相等",
    "prefix": "形如 task.* 匹配 task. 开头的全部事件",
    "star": "* 匹配全部",
    "gap_not_loss": "经过滤的订阅看不到某些全局 seq 不代表丢包"
  },
  "retention": {
    "log_max": 1000,
    "note": "有限内存日志，尽力而为补发；不是持久事件存储。cursor 早于窗口 → resync_required/cursor_expired。"
  },
  "events": [
    {
      "type": "task.started",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true},
        "exclusivity": {"type": "string", "enum": ["motion", "soft"], "required": true}
      }
    },
    {
      "type": "task.progress",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "progress": {"type": "number", "minimum": 0, "maximum": 1, "required": true}
      }
    },
    {
      "type": "task.completed",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true}
      }
    },
    {
      "type": "task.failed",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true},
        "error": {"type": "object", "required": true, "$ref": "TaskError"},
        "reason": {
          "type": "string",
          "required": false,
          "enum": ["board_reset", "timeout", "lost_link", "device_fault", "internal", "unspecified"]
        }
      }
    },
    {
      "type": "task.cancelled",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true},
        "reason": {
          "type": "string",
          "required": true,
          "enum": ["requested", "stop", "preempted", "deadline", "pause_timeout"]
        }
      },
      "notes": "pause_timeout = 暂停超过上限（pause_max_seconds）自动取消；同时会先发 task.pause_expired。"
    },
    {
      "type": "task.paused",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true},
        "pause_expires_at": {
          "type": "integer",
          "required": true,
          "notes": "本次暂停的自动取消截止时间（Unix epoch 毫秒）；到期转 cancelled/reason=pause_timeout。"
        }
      },
      "notes": "暂停不是终态：任务仍在表里、finished_at 为 null。它也不是 mute——音频与播报不受影响。"
    },
    {
      "type": "task.resumed",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "capability": {"type": "string", "required": true},
        "paused_ms": {"type": "integer", "required": true, "notes": "本次暂停持续时长（毫秒）。"}
      },
      "notes": "恢复不新建任务、不重新签发审批凭据：任务 id 不变，也不会有第二个 task.started。"
    },
    {
      "type": "task.pause_expired",
      "category": "task",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": true},
        "announced": {
          "type": "boolean",
          "required": true,
          "notes": "固定提示是否真的交给了 TTS。音频桥不可用时为 false——不伪造「已播报」。"
        }
      },
      "notes": "暂停超过上限：随后任务转 cancelled(reason=pause_timeout)。单独一条事件让「为什么停」在时间线上可读，而不是只靠 reason 猜。"
    },
    {
      "type": "motion.plan",
      "category": "motion",
      "payload": {
        "task_id": {"type": "string", "required": true},
        "left_steps": {"type": "integer", "required": true},
        "right_steps": {"type": "integer", "required": true},
        "eta_ms": {"type": "integer", "required": false},
        "note": {"type": "string", "required": false}
      },
      "notes": "计划摘要，不代表已到位；应发步数不是实际位移证明。"
    },
    {
      "type": "safety.stopped",
      "category": "safety",
      "payload": {
        "reason": {
          "type": "string",
          "required": true,
          "enum": ["stop", "watchdog", "watchdog_release", "task_cancel", "task_pause", "link_lost", "startup"]
        },
        "source": {"type": "string", "required": true, "enum": ["host", "board"]},
        "task_id": {"type": "string", "required": false}
      },
      "notes": "只表示停止动作已发生，不表示物理静止（板侧应答 ≠ 物理静止证明）。"
    },
    {
      "type": "safety.stop_requested",
      "category": "safety",
      "no_state": true,
      "payload": {
        "cause": {
          "type": "string",
          "required": true,
          "enum": [
            "user_voice",
            "user_stop_api",
            "obstacle",
            "watchdog_timeout",
            "param_out_of_range",
            "observation_stale",
            "device_lost",
            "bridge_exit",
            "internal_error"
          ],
          "notes": "结构化停止原因。上层判据只读本字段；detail 只供人读，不得用中文 grep 代替 cause。"
        },
        "state": {
          "type": "string",
          "required": true,
          "enum": ["requested", "confirmed", "unknown"],
          "notes": "confirmed 只表示板侧已应答停止；unknown 表示无法确认板侧停稳（例如链路已断），不得升级成 confirmed。"
        },
        "detail": {"type": "string", "required": true},
        "task_id": {
          "type": "string",
          "required": false,
          "notes": "被停止的运动任务（若本次停止确实终止了一个运动任务）；agentd 用它把安全停止关联回发起该任务的 run。"
        },
        "run_id": {
          "type": "string",
          "required": false,
          "notes": "agentd 语义事件可回填的 run 关联；robotd 本身不产生 run_id。"
        }
      },
      "notes": "「为什么停」的唯一结构化事实。safety.stopped 只说明停止动作发生，本事件补 cause/确认状态。"
    },
    {
      "type": "safety.slowdown",
      "category": "safety",
      "no_state": true,
      "payload": {
        "active": {"type": "boolean", "required": true},
        "reason": {"type": "string", "required": true},
        "detail": {"type": "string", "required": false}
      },
      "notes": "减速提示**仅在减速状态变化时发送**（进入或解除各一条），不是逐帧/逐次控制流；完整 Nav/障碍物算法不在本 issue 范围。"
    },
    {
      "type": "device.ready",
      "category": "device",
      "payload": {
        "device": {"type": "string", "required": true, "enum": ["esp32", "camera", "audio", "pump"]},
        "firmware": {"type": "string", "required": false},
        "after": {"type": "string", "required": false, "enum": ["connect", "reset", "recover"]}
      }
    },
    {
      "type": "device.lost",
      "category": "device",
      "payload": {
        "device": {"type": "string", "required": true, "enum": ["esp32", "camera", "audio", "pump"]},
        "reason": {"type": "string", "required": false}
      }
    },
    {
      "type": "device.recovered",
      "category": "device",
      "payload": {
        "device": {"type": "string", "required": true, "enum": ["esp32", "camera", "audio", "pump"]}
      }
    },
    {
      "type": "device.reset",
      "category": "device",
      "payload": {
        "device": {"type": "string", "required": true},
        "firmware": {"type": "string", "required": false},
        "pose_valid": {"type": "boolean", "required": true},
        "odometry_reset": {"type": "boolean", "required": true}
      },
      "notes": "板复位会清零板侧步数：必须作废 pose 与里程，并终止相关任务，不自动续跑。"
    },
    {
      "type": "device.changed",
      "category": "device",
      "payload": {
        "device": {"type": "string", "required": true},
        "state": {"type": "string", "required": true},
        "reason": {"type": "string", "required": false}
      }
    },
    {
      "type": "state.rejected",
      "category": "state",
      "no_state": true,
      "payload": {
        "type": {"type": "string", "required": true},
        "payload_keys": {"type": "array", "required": true},
        "reason": {
          "type": "string",
          "required": true,
          "enum": ["unknown_device", "invalid_device_status", "reduce_failed"]
        }
      },
      "notes": "某条事件通过了契约校验但归并没有生效：只说明被拒事件的类型、字段名与原因。不得携带 payload 原文——重放原文等于绕过 scrub 把被拒输入再发布一次。"
    },
    {
      "type": "audio.state",
      "category": "audio",
      "no_state": true,
      "payload": {"$ref": "AudioState"}
    },
    {
      "type": "speech.ready",
      "category": "speech",
      "no_state": true,
      "payload": {
        "task_id": {"type": "string", "required": false},
        "utterance_id": {"type": "string", "required": true},
        "trigger": {
          "type": "string",
          "required": true,
          "enum": ["api", "auto"],
          "notes": "这一轮是谁开的：api = POST /v1/speech/listen；auto = 桥 VAD 自动开轮或 AudioRuntime 自动续听。下游不得再用 task_id is None 猜。"
        },
        "locale": {"type": "string", "required": false},
        "auto_endpoint": {"type": "boolean", "required": false}
      }
    },
    {
      "type": "speech.started",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": false},
        "trigger": {
          "type": "string",
          "required": true,
          "enum": ["api", "auto"],
          "notes": "与 speech.ready 同源：api 由显式 listen 开启，auto 由桥 VAD / runtime 续听开启。"
        },
        "rms_db": {"type": "number", "required": false},
        "aec_erle_db": {
          "type": "number",
          "required": false,
          "notes": "桥在最近 1 秒内上报的 AEC 回声抑制量（render_db - mic_db）。只是事实：是否回声（审批 settle 的证据）由 agentd 判，是否打断由 robotd 的 AudioRuntime 判。"
        }
      }
    },
    {
      "type": "speech.gate",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "decision": {"type": "string", "required": true, "enum": ["pass", "suppressed"]},
        "reason": {
          "type": "string",
          "required": true,
          "enum": ["barge_in", "echo", "no_erle", "no_db", "not_speaking", "no_threshold"]
        },
        "db": {"type": "number", "required": false},
        "aec_erle_db": {"type": "number", "required": false},
        "threshold_db": {"type": "number", "required": false}
      },
      "notes": "robotd 的 AudioRuntime 在每次 VAD 上升时发一条：decision=pass 表示放行打断，suppressed 表示不打断。pass 与 suppressed 都必须发，否则「被压掉的声音」在时间线上没有分母。判定权只在这里（桥只报事实，agentd 不重算）。"
    },
    {
      "type": "speech.speech_ended",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "audio_ms": {"type": "integer", "required": false}
      }
    },
    {
      "type": "speech.partial",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "revision": {"type": "integer", "required": true},
        "text": {"type": "string", "required": true}
      },
      "notes": "partial 必须带 revision，且不得与 final 混淆。"
    },
    {
      "type": "speech.endpoint",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "reason": {"type": "string", "required": true},
        "speech_ms": {"type": "integer", "required": false},
        "silence_ms": {"type": "integer", "required": false}
      }
    },
    {
      "type": "speech.final",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "text": {"type": "string", "required": true},
        "stop_reason": {"type": "string", "required": false},
        "no_speech": {"type": "boolean", "required": false}
      }
    },
    {
      "type": "speech.ignored",
      "category": "speech",
      "no_state": true,
      "payload": {
        "utterance_id": {"type": "string", "required": true},
        "reason": {
          "type": "string",
          "required": true,
          "enum": ["busy", "echo", "empty", "speaking"],
          "notes": "这一轮为什么没进入分发。busy=已有轮次/活动任务；echo=自听；empty=空文本；speaking=机器人正在播报且这一轮不是打断（GH-9 / V06）。speaking 是 AudioRuntime 的状态判定，与 speech.gate 的声学判定不是同一件事。"
        },
        "run_id": {"type": "string", "required": false}
      },
      "notes": "窄事件：让「这一轮被丢了」在 robotd 与 agentd 的同一条时间线上有分母。不复用 speech.gate——gate 判的是「要不要打断」，语义不同。"
    },
    {
      "type": "speech.interrupted",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": false},
        "reason": {"type": "string", "required": true}
      }
    },
    {
      "type": "speech.tts_started",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": false},
        "voice": {"type": "string", "required": false},
        "chunks": {"type": "integer", "required": false},
        "approval_id": {"type": "string", "required": false},
        "kind": {"type": "string", "required": false}
      }
    },
    {
      "type": "speech.tts_chunk_started",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "index": {"type": "integer", "required": true}
      }
    },
    {
      "type": "speech.tts_chunk_finished",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "index": {"type": "integer", "required": true}
      }
    },
    {
      "type": "speech.tts_finished",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": false},
        "chunks": {"type": "integer", "required": false},
        "played": {"type": "integer", "required": false},
        "dropped": {
          "type": "integer",
          "required": false,
          "notes": "已被合成完成（finished_n）但未播出的块数；正常播完时通常为 0，只有桥在终态回报里给出不一致的 played 时才出现。对账式同 speech.tts_cancelled：played + dropped == finished_n。"
        },
        "queue_dropped": {
          "type": "integer",
          "required": false,
          "notes": "桥的有界队列因满丢弃的块数（背压事实，非播放计数）。"
        },
        "approval_id": {"type": "string", "required": false},
        "kind": {"type": "string", "required": false}
      }
    },
    {
      "type": "speech.tts_cancelled",
      "category": "speech",
      "no_state": true,
      "payload": {
        "response_id": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": false},
        "reason": {
          "type": "string",
          "required": true,
          "enum": [
            "barge_in",
            "user_cancel",
            "stop",
            "announce_failed",
            "interrupted",
            "bridge_exit",
            "bridge_shutdown",
            "stop_speak",
            "engine_unavailable",
            "synth_error",
            "muted"
          ],
          "notes": "中止原因。barge_in=用户在播报中开口打断；user_cancel=用户显式请求停止播报（POST /v1/speech/abort）；其余为安全旁路、桥退出或合成失败。"
        },
        "played": {"type": "integer", "required": false},
        "dropped": {
          "type": "integer",
          "required": false,
          "notes": "已被合成完成（finished_n）但因中止而未播出的块数。对账式（实现锁定）：played + dropped == finished_n，且 played ≤ chunks。队列满丢弃（桥侧 tts_chunk_dropped，见 queue_dropped）不计入本字段。"
        },
        "queue_dropped": {
          "type": "integer",
          "required": false,
          "notes": "桥的有界队列因满而丢弃的块数（桥侧背压事实，非打断计数）。与 dropped 分开：不计入 played + dropped == finished_n。"
        },
        "approval_id": {"type": "string", "required": false},
        "kind": {"type": "string", "required": false}
      }
    },
    {
      "type": "speech.announce_failed",
      "category": "speech",
      "no_state": true,
      "payload": {
        "approval_id": {"type": "string", "required": true},
        "kind": {"type": "string", "required": true},
        "task_id": {"type": "string", "required": true},
        "reason": {"type": "string", "required": true}
      }
    }
  ],
  "reserved_unimplemented": [
    {
      "type": "vision.*",
      "category": "vision",
      "status": "unimplemented",
      "why": "R15 接 macOS Vision 快速检测后才产生；现在不得编造观测。"
    },
    {
      "type": "camera.*",
      "category": "camera",
      "status": "unimplemented",
      "why": "R12 相机采集才有帧级事件；当前只有抓帧一次性返回。"
    },
    {
      "type": "people.* / person.*",
      "category": "vision",
      "status": "unimplemented",
      "why": "需要 track 生命周期（R15）；track id 不是人物身份。"
    }
  ],
  "excluded_from_public": [
    {
      "type": "board.log",
      "why": "原始串口文本行；只允许出现在 debug 旁路（--debug）"
    },
    {
      "type": "board.tx / board.rx",
      "why": "调试面板观察串口用；不得进入 Agent 可见事件流"
    }
  ],
  "notes": [
    "为什么单独一份 JSON 而不是塞进 OpenAPI：OpenAPI 3.0 的 oneOf + discriminator 无法表达『type 取值决定 payload 形状』这一组 20+ 变体，塞进去会让 schema 比散文更难读。独立登记表仍可被 generate.mjs 校验与生成。",
    "登记表与 openapi.yaml 的 components.schemas 共用 envelope：WsEvent。两份文件的 version 必须一致。",
    "新增事件时必须同时改本文件与 docs/spec/robotd-interface-contract.md §6.2 的类别表。",
    "每条事件必须二选一：在 robotd/src/robotd/core/kernel.py 的 _reduce 有显式分支（改状态），或标 no_state: true（合法但只记日志）。robotd/tests/contract/test_event_registry.py 双向校验；未登记的事件名在分配序号前即被拒绝。"
  ]
}
