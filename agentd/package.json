{
  "name": "agentd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mac mini 移动机器人的大脑与日常界面（TypeScript，运行期零外部依赖）",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agentd": "./src/agentd/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/agentd/cli.ts",
    "start:manual": "node --experimental-strip-types src/agentd/cli.ts --allow-manual-approve",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:contract",
    "test:unit": "node --experimental-strip-types tests/unit/store.mjs && node --experimental-strip-types tests/unit/runs.mjs && node --experimental-strip-types tests/unit/run-request.mjs && node --experimental-strip-types tests/unit/http.mjs && node --experimental-strip-types tests/unit/router.test.ts",
    "test:contract": "node --experimental-strip-types tests/contract/events.mjs && node --experimental-strip-types tests/contract/router.mjs",
    "test:live": "node --experimental-strip-types tests/integration/client.mjs",
    "test:codex": "node --experimental-strip-types tests/integration/codex-probe.mjs",
    "test:e2e": "node --experimental-strip-types tests/e2e/agentd.mjs",
    "pretest": "npm run test:announcer",
    "test:announcer": "node --experimental-strip-types tests/unit/announcer.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.164.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
