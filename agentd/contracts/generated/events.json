{
  "version": 1,
  "source": "agentd/contracts/events.json",
  "envelope": {
    "required": [
      "event_id",
      "cursor",
      "type",
      "version",
      "severity",
      "occurred_at",
      "received_at",
      "source"
    ],
    "forbidden_payload_keys": [
      "reasoning",
      "chain_of_thought",
      "private_thoughts",
      "credential",
      "api_key",
      "authorization",
      "token",
      "raw_prompt",
      "raw_transcript"
    ],
    "forbidden_payload_keys_reason": "模型私有思维链与任何凭证都不得进入事件库：事件库会被导出、被历史页面展示、被审计阅读。"
  },
  "retention": {
    "semantic_events_days": 90,
    "audit_days": 365,
    "note": "语义事件与审计分开配置。清理必须给出时间范围与保留边界，不能让用户误以为历史无限完整。"
  },
  "severity_labels": {
    "info": "正常",
    "warning": "需要注意",
    "error": "故障"
  },
  "registered_types": [
    "approval.expired",
    "approval.ignored",
    "approval.repeat_requested",
    "approval.resolved",
    "approval.unavailable",
    "approval.waiting",
    "daemon.recovered",
    "daemon.started",
    "dependency.recovered",
    "dependency.unavailable",
    "model.activated",
    "model.activation_failed",
    "model.validated",
    "model.validation_failed",
    "observation.gap",
    "observation.speech_ignored",
    "person.appeared",
    "person.lost",
    "person.moved",
    "route.clarify",
    "route.matched",
    "run.accepted",
    "run.cancelled",
    "run.duplicate",
    "run.finished",
    "run.step_changed",
    "run.waiting_confirmation",
    "run.waiting_input",
    "safety.stop_requested",
    "speech.audio_recovered",
    "speech.audio_unavailable",
    "speech.no_speech",
    "speech.speak_cancelled",
    "speech.speak_failed",
    "speech.spoken",
    "speech.utterance_heard",
    "store.recovered",
    "store.unwritable",
    "tool.failed",
    "tool.outcome_unknown",
    "tool.requested",
    "tool.succeeded"
  ],
  "categories": [
    "approval",
    "daemon",
    "dependency",
    "model",
    "observation",
    "route",
    "run",
    "safety",
    "speech",
    "store",
    "tool",
    "vision"
  ],
  "templates": [
    {
      "type": "daemon.started",
      "category": "daemon",
      "severity": "info",
      "title": "agentd 已启动",
      "summary": "进程 {pid} 启动，契约版本 {contract_version}。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "pid",
        "contract_version",
        "recovered_runs"
      ],
      "required_fields": [
        "pid",
        "contract_version",
        "recovered_runs"
      ],
      "payload_spec": {
        "pid": {
          "type": "integer",
          "required": true
        },
        "contract_version": {
          "type": "string",
          "required": true
        },
        "recovered_runs": {
          "type": "integer",
          "required": true,
          "note": "重启时被标为 interrupted 的活动 run 数"
        }
      },
      "rate_limit": null
    },
    {
      "type": "daemon.recovered",
      "category": "daemon",
      "severity": "warning",
      "title": "上次退出时有未完成的任务",
      "summary": "{interrupted_runs} 个任务被标记为中断；旧审批已作废，不会自动恢复执行。",
      "impact": null,
      "advice": "需要继续的话，请新建任务并重新确认。",
      "is_recovery": false,
      "payload_fields": [
        "interrupted_runs",
        "cancelled_approvals"
      ],
      "required_fields": [
        "interrupted_runs",
        "cancelled_approvals"
      ],
      "payload_spec": {
        "interrupted_runs": {
          "type": "integer",
          "required": true
        },
        "cancelled_approvals": {
          "type": "integer",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "store.unwritable",
      "category": "store",
      "severity": "error",
      "title": "历史库不可写",
      "summary": "无法写入 {path}：{reason}。新的需要审批的动作已被拒绝。",
      "impact": "任务与审批无法记录，因此不允许开始会产生后果的动作。",
      "advice": "检查磁盘空间与目录权限。停止机器人不受影响，仍可直达使用。",
      "is_recovery": false,
      "payload_fields": [
        "path",
        "reason"
      ],
      "required_fields": [
        "path",
        "reason"
      ],
      "payload_spec": {
        "path": {
          "type": "string",
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "store.recovered",
      "category": "store",
      "severity": "info",
      "title": "历史库已恢复可写",
      "summary": "写入恢复正常；此前的降级已结束。",
      "impact": null,
      "advice": null,
      "is_recovery": true,
      "payload_fields": [
        "path"
      ],
      "required_fields": [
        "path"
      ],
      "payload_spec": {
        "path": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "dependency.unavailable",
      "category": "dependency",
      "severity": "warning",
      "title": "{dependency} 暂不可用",
      "summary": "{reason}",
      "impact": "{impact}",
      "advice": "{advice}",
      "is_recovery": false,
      "payload_fields": [
        "dependency",
        "reason",
        "impact",
        "advice"
      ],
      "required_fields": [
        "dependency",
        "reason"
      ],
      "payload_spec": {
        "dependency": {
          "type": "string",
          "required": true,
          "enum": [
            "robotd",
            "harness",
            "model",
            "audio"
          ]
        },
        "reason": {
          "type": "string",
          "required": true
        },
        "impact": {
          "type": "string",
          "required": false
        },
        "advice": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "dependency.recovered",
      "category": "dependency",
      "severity": "info",
      "title": "{dependency} 已恢复",
      "summary": "{detail}",
      "impact": null,
      "advice": null,
      "is_recovery": true,
      "payload_fields": [
        "dependency",
        "detail",
        "gap_from"
      ],
      "required_fields": [
        "dependency",
        "detail"
      ],
      "payload_spec": {
        "dependency": {
          "type": "string",
          "required": true
        },
        "detail": {
          "type": "string",
          "required": true
        },
        "gap_from": {
          "type": "string",
          "required": false,
          "note": "断线起点；若上游无回放能力，此区间历史不完整"
        }
      },
      "rate_limit": null
    },
    {
      "type": "observation.gap",
      "category": "observation",
      "severity": "warning",
      "title": "有一段时间的身体状态没有记录",
      "summary": "{from} 到 {to} 期间与 {dependency} 的连接中断，这段历史不完整。",
      "impact": "我们既不补齐也不编造这段时间发生了什么。",
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "dependency",
        "from",
        "to",
        "reason"
      ],
      "required_fields": [
        "dependency",
        "from",
        "to",
        "reason"
      ],
      "payload_spec": {
        "dependency": {
          "type": "string",
          "required": true
        },
        "from": {
          "type": "string",
          "required": true
        },
        "to": {
          "type": "string",
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true,
          "enum": [
            "ws_disconnected",
            "cursor_expired",
            "instance_changed",
            "upstream_no_replay"
          ]
        }
      },
      "rate_limit": null
    },
    {
      "type": "observation.speech_ignored",
      "category": "speech",
      "severity": "info",
      "title": "这句话没有被当成指令",
      "summary": "语音被忽略（{reason}），没有创建任务。",
      "impact": "机器人没有执行这句话；保留原因，便于区分「没听见」与「听见了但故意不执行」。",
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "reason",
        "utterance_id"
      ],
      "required_fields": [
        "reason"
      ],
      "payload_spec": {
        "reason": {
          "type": "string",
          "required": true,
          "enum": [
            "busy",
            "echo",
            "empty",
            "speaking"
          ]
        },
        "utterance_id": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.accepted",
      "category": "run",
      "severity": "info",
      "title": "收到请求",
      "summary": "「{prompt}」已受理，执行方式：{route_label}。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "prompt",
        "route",
        "source",
        "fast_rule"
      ],
      "required_fields": [
        "prompt",
        "route",
        "source"
      ],
      "payload_spec": {
        "prompt": {
          "type": "string",
          "required": true,
          "note": "用户原始请求（已截断到 200 字符）；不含思维链"
        },
        "route": {
          "type": "string",
          "required": true
        },
        "source": {
          "type": "string",
          "required": true
        },
        "fast_rule": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.duplicate",
      "category": "run",
      "severity": "info",
      "title": "重复的请求已忽略",
      "summary": "同一请求已存在（{idempotency_key}），未重复执行。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "idempotency_key"
      ],
      "required_fields": [
        "idempotency_key"
      ],
      "payload_spec": {
        "idempotency_key": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.waiting_input",
      "category": "run",
      "severity": "warning",
      "title": "需要你补充信息",
      "summary": "{question}",
      "impact": null,
      "advice": "补充后我会继续，不会先猜着执行。",
      "is_recovery": false,
      "payload_fields": [
        "question"
      ],
      "required_fields": [
        "question"
      ],
      "payload_spec": {
        "question": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.step_changed",
      "category": "run",
      "severity": "info",
      "title": "进行到：{step_title}",
      "summary": "{step_title}（{state_label}）",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "step_id",
        "step_title",
        "state"
      ],
      "required_fields": [
        "step_id",
        "step_title",
        "state"
      ],
      "payload_spec": {
        "step_id": {
          "type": "string",
          "required": true
        },
        "step_title": {
          "type": "string",
          "required": true
        },
        "state": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.waiting_confirmation",
      "category": "run",
      "severity": "warning",
      "title": "等待你确认「{action_label}」",
      "summary": "已识别目标，机器人正在等待你明确确认。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "approval_id",
        "action_label",
        "window_opened_at"
      ],
      "required_fields": [
        "approval_id",
        "action_label",
        "window_opened_at"
      ],
      "payload_spec": {
        "approval_id": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "window_opened_at": {
          "type": "string",
          "required": true,
          "description": "确认窗口开启时刻（播报完成之后）。早于此刻的 utterance 不能用来确认这次动作。"
        }
      },
      "rate_limit": null
    },
    {
      "type": "run.finished",
      "category": "run",
      "severity": "info",
      "title": "任务{outcome_label}",
      "summary": "{detail}",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "outcome",
        "detail",
        "duration_ms"
      ],
      "required_fields": [
        "outcome",
        "detail"
      ],
      "payload_spec": {
        "outcome": {
          "type": "string",
          "required": true
        },
        "detail": {
          "type": "string",
          "required": true
        },
        "duration_ms": {
          "type": "integer",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "tool.requested",
      "category": "tool",
      "severity": "info",
      "title": "请求执行：{action_label}",
      "summary": "参数：{args_summary}",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "args_summary",
        "requires_approval"
      ],
      "required_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "args_summary",
        "requires_approval"
      ],
      "payload_spec": {
        "tool_call_id": {
          "type": "string",
          "required": true
        },
        "capability": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "args_summary": {
          "type": "string",
          "required": true
        },
        "requires_approval": {
          "type": "boolean",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "tool.succeeded",
      "category": "tool",
      "severity": "info",
      "title": "已执行：{action_label}",
      "summary": "{detail}",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "robot_task_id",
        "detail"
      ],
      "required_fields": [
        "tool_call_id",
        "capability",
        "action_label"
      ],
      "payload_spec": {
        "tool_call_id": {
          "type": "string",
          "required": true
        },
        "capability": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "robot_task_id": {
          "type": "string",
          "required": false
        },
        "detail": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "tool.failed",
      "category": "tool",
      "severity": "error",
      "title": "执行失败：{action_label}",
      "summary": "{detail}",
      "impact": null,
      "advice": "{advice}",
      "is_recovery": false,
      "payload_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "code",
        "detail",
        "advice"
      ],
      "required_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "detail"
      ],
      "payload_spec": {
        "tool_call_id": {
          "type": "string",
          "required": true
        },
        "capability": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "code": {
          "type": "string",
          "required": false
        },
        "detail": {
          "type": "string",
          "required": true
        },
        "advice": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "tool.outcome_unknown",
      "category": "tool",
      "severity": "error",
      "title": "执行结果待确认：{action_label}",
      "summary": "请求已发出，但没有收到确认结果（{reason}）。",
      "impact": "不能当作「没有执行」。涉及运动时请确认机器人实际状态。",
      "advice": "系统会先查询实际状态再决定，不会自动重新发送这个动作。",
      "is_recovery": false,
      "payload_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "robot_task_id",
        "reason"
      ],
      "required_fields": [
        "tool_call_id",
        "capability",
        "action_label",
        "reason"
      ],
      "payload_spec": {
        "tool_call_id": {
          "type": "string",
          "required": true
        },
        "capability": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "robot_task_id": {
          "type": "string",
          "required": false
        },
        "reason": {
          "type": "string",
          "required": true
        }
      },
      "rate_limit": null
    },
    {
      "type": "approval.waiting",
      "category": "approval",
      "severity": "warning",
      "title": "等待语音确认",
      "summary": "需要确认：{action_label}。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "approval_id",
        "action_label",
        "args_summary",
        "window_opened_at",
        "window_closes_at"
      ],
      "required_fields": [
        "approval_id",
        "action_label",
        "args_summary",
        "window_opened_at"
      ],
      "payload_spec": {
        "approval_id": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "args_summary": {
          "type": "string",
          "required": true
        },
        "window_opened_at": {
          "type": "string",
          "required": true
        },
        "window_closes_at": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "approval.repeat_requested",
      "category": "approval",
      "severity": "info",
      "title": "用户要求再说一遍",
      "summary": "复述第 {repeat_count} 次重播「{action_label}」；确认窗口不重置。",
      "impact": "没有推进审批状态，也不算一次拒绝。",
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "approval_id",
        "action_label",
        "repeat_count",
        "max_repeats",
        "utterance_id"
      ],
      "required_fields": [
        "approval_id",
        "action_label",
        "repeat_count",
        "max_repeats"
      ],
      "payload_spec": {
        "approval_id": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "repeat_count": {
          "type": "integer",
          "required": true
        },
        "max_repeats": {
          "type": "integer",
          "required": true
        },
        "utterance_id": {
          "type": "string",
          "required": false
        }
      },
      "rate_limit": null
    },
    {
      "type": "approval.resolved",
      "category": "approval",
      "severity": "info",
      "title": "确认{decision_label}",
      "summary": "{action_label}：{decision_label}（{decided_by}）。",
      "impact": null,
      "advice": null,
      "is_recovery": false,
      "payload_fields": [
        "approval_id",
        "action_label",
        "status",
        "decided_by",
        "utterance_id",
        "reason"
      ],
      "required_fields": [
        "approval_id",
        "action_label",
        "status",
        "decided_by"
      ],
      "payload_spec": {
        "approval_id": {
          "type": "string",
          "required": true
        },
        "action_label": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": true
        },
        "decided_by": {
          "type": "string",
          "required": true
        },
        "utterance_id": {
          "type": "string",
          "required": false,
          "description": "采纳的那一轮 speech.final 的 utterance_id（审计用）"
        },
        "reason": {
          "type": "string",
          "required": false,
          "description": "结束原因（如 denied / repeat_limit）；不改变 status 枚举，只解释这一次为什么这样收尾。"
        }
      },
      "rate_limit": null
    },
    {
      "type": "approval.expired",
      "category": "approval",
      "severity": "warning",
      "title": "确认窗口已过期",
      "summary": "「{action_label}」的确认窗口已过期，没有执行。",
